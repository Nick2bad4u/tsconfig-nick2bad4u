{
    "$schema": "https://www.schemastore.org/tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": false,
        "isolatedDeclarations": true,
        "isolatedModules": true,
        "noEmit": false,
        "noEmitOnError": true,
        "sourceMap": true
    }
}
